{
  "enabledPlugins": {
    "serena@claude-plugins-official": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /home/jbarden/repos/astardev-scraperplaying && /home/jbarden/.local/bin/graphify update . >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/home/jbarden/.local/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/home/jbarden/.local/bin/graphify hook-guard read"
          }
        ]
      }
    ]
  }
}