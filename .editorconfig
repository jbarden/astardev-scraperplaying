root = true

# Code-style severities mirror .claude/rules (standards.md, styling.md).
# Rules are 'warning' (TreatWarningsAsErrors makes them fail the build).
#
# Not enforceable by an analyzer, so review-only:
#   - blank line before every 'return' (except in short if/else/try blocks)
#   - no single-letter variable names, except loop indexes (i, j) and framework names (e, ex)

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,json,yml,yaml}]
indent_style = space

[*.cs]

# ── Expression-bodied members (IDE0021/22/25/26/53/61) ───────────────────────
csharp_style_expression_bodied_methods = when_on_single_line:warning
csharp_style_expression_bodied_constructors = false:silent
csharp_style_expression_bodied_operators = when_on_single_line:warning
csharp_style_expression_bodied_properties = true:warning
csharp_style_expression_bodied_indexers = true:warning
csharp_style_expression_bodied_accessors = true:warning
csharp_style_expression_bodied_lambdas = true:warning
csharp_style_expression_bodied_local_functions = when_on_single_line:warning

# ── Braces: single-line statements go without braces (IDE0011) ───────────────
csharp_prefer_braces = when_multiline:warning

# ── Modern C# (IDE0161, IDE0290, IDE0300-series, IDE0058) ────────────────────
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_prefer_primary_constructors = true:warning
dotnet_style_prefer_collection_expression = true:warning
csharp_style_unused_value_expression_statement_preference = discard_variable:warning
csharp_style_unused_value_assignment_preference = discard_variable:warning

# ── Immutability (IDE0044) ───────────────────────────────────────────────────
dotnet_style_readonly_field = true:warning

# ── No 'this.' qualification (IDE0003/IDE0009) ───────────────────────────────
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# ── Predefined type names: 'string' not 'String' (IDE0049) ───────────────────
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

# ── Null handling: prefer pattern checks (IDE0041, IDE0150, IDE0270 family) ──
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning
csharp_style_prefer_null_check_over_type_check = true:warning
csharp_style_prefer_pattern_matching = true:warning
csharp_style_prefer_not_pattern = true:warning

# ── Usings ───────────────────────────────────────────────────────────────────
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# ── Naming (IDE1006): consts PascalCase, other private fields camelCase (no underscore prefix) ──
dotnet_naming_rule.constants_pascal_case.symbols = constant_fields
dotnet_naming_rule.constants_pascal_case.style = pascal_case_style
dotnet_naming_rule.constants_pascal_case.severity = warning
dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

dotnet_naming_rule.private_fields_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_camel_case.style = camel_case_style
dotnet_naming_rule.private_fields_camel_case.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.camel_case_style.capitalization = camel_case
# Build only enforces IDE1006 when its severity is also set explicitly
dotnet_diagnostic.IDE1006.severity = warning

# ── Code-analysis rules cleaned up in #270: keep them fixed ──────────────────
dotnet_diagnostic.CA1508.severity = warning
dotnet_diagnostic.CA1849.severity = warning
dotnet_diagnostic.CA2000.severity = warning

# ── Tests use when_..._then_... snake_case names ─────────────────────────────
[{**.TestsUnit/**.cs,**.TestsIntegration/**.cs}]
dotnet_diagnostic.IDE1006.severity = none
# Shouldly assertions return their subject; discarding every one adds only noise
dotnet_diagnostic.IDE0058.severity = none

# ── Generated code ───────────────────────────────────────────────────────────
[*.{generated,g}.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

# EF Core migrations are tool-generated
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
