root = true

# Code-style severities mirror .claude/rules (standards.md, styling.md).
# Everything is 'suggestion' for now: promote one rule at a time to 'warning' once its
# violations are fixed (TreatWarningsAsErrors is on, so a promoted rule fails the build).
#
# Not enforceable by an analyzer, so review-only:
#   - blank line before every 'return' (except in short if/else/try blocks)
#   - no single-letter variable names, except loop indexes (i, j) and framework names (e, ex)

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,json,yml,yaml}]
indent_style = space

[*.cs]

# ── Expression-bodied members (IDE0021/22/25/26/53/61) ───────────────────────
csharp_style_expression_bodied_methods = when_on_single_line:warning
csharp_style_expression_bodied_constructors = false:silent
csharp_style_expression_bodied_operators = when_on_single_line:warning
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_indexers = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion
csharp_style_expression_bodied_local_functions = when_on_single_line:suggestion

# ── Braces: single-line statements go without braces (IDE0011) ───────────────
csharp_prefer_braces = when_multiline:suggestion

# ── Modern C# (IDE0161, IDE0290, IDE0300-series, IDE0058) ────────────────────
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_style_prefer_collection_expression = true:suggestion
csharp_style_unused_value_expression_statement_preference = discard_variable:suggestion
csharp_style_unused_value_assignment_preference = discard_variable:suggestion

# ── Immutability (IDE0044) ───────────────────────────────────────────────────
dotnet_style_readonly_field = true:suggestion

# ── No 'this.' qualification (IDE0003/IDE0009) ───────────────────────────────
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# ── Predefined type names: 'string' not 'String' (IDE0049) ───────────────────
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

# ── Null handling: prefer pattern checks (IDE0041, IDE0150, IDE0270 family) ──
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:suggestion
csharp_style_prefer_null_check_over_type_check = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion

# ── Usings ───────────────────────────────────────────────────────────────────
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:suggestion

# ── Naming: private fields are _camelCase (IDE1006) ──────────────────────────
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# ── Tests use when_..._then_... snake_case names ─────────────────────────────
[**/*.{TestsUnit,TestsIntegration}/**/*.cs]
dotnet_diagnostic.IDE1006.severity = none

# ── Generated code ───────────────────────────────────────────────────────────
[*.{generated,g}.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
