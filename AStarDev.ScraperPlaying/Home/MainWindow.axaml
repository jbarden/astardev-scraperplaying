<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AStarDev.ScraperPlaying.Home.MainWindow"
        Title="AStarDev Scraper Playing"
        Width="1800"
        Height="800"
        MinWidth="480"
        MinHeight="320">
  <Grid RowDefinitions="Auto,*">
    <Menu Grid.Row="0" Margin="5,5,0,0">
      <MenuItem Header="_File">
        <MenuItem x:Name="ImportConfigurationMenuItem" Header="_Import Configuration" Click="ImportConfiguration" />
        <MenuItem x:Name="ExportConfigurationMenuItem" Header="_Export Configuration" Click="ExportConfiguration" />
        <Separator />
        <MenuItem Header="E_xit" Click="Exit" />
      </MenuItem>
    </Menu>
    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" Margin="32">
      <TextBlock Text="AStarDev Scraper Playing"
                 FontSize="28"
                 FontWeight="SemiBold" />
      <StackPanel Grid.Row="1"
                  Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  Spacing="12"
                  Margin="0,24,0,0">
        <Button x:Name="RunScraperButton" Content="Run Scraper" Click="RunScraper" />
        <Button x:Name="CancelButton" Content="Cancel" Click="CancelOperation" IsEnabled="False" />
      </StackPanel>
      <Grid Grid.Row="2"
            ColumnDefinitions="*,*"
            ColumnSpacing="24"
            Margin="0,24,0,0">
        <Border Grid.Column="0"
                Padding="24"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                CornerRadius="8">
          <ScrollViewer x:Name="StatusScrollViewer" VerticalScrollBarVisibility="Auto">
            <TextBlock Text="Ready for action." x:Name="StatusTextBlock" TextWrapping="Wrap" FontSize="12" />
          </ScrollViewer>
        </Border>
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
          <ToggleSwitch x:Name="ImageDisplayToggle"
                        Grid.Row="0"
                        OnContent="Display Live Preview"
                        OffContent="Hide Live Preview"
                        IsChecked="True"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,12"
                        Click="ToggleImageDisplay" />
          <Border Grid.Row="1"
                  Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                  CornerRadius="12"
                  ClipToBounds="True">
            <Grid RowDefinitions="*,Auto">
              <Image x:Name="DownloadedImage" Grid.Row="0" Stretch="Uniform" />
              <StackPanel x:Name="ImageDetailsPanel" Grid.Row="1" Orientation="Vertical" Spacing="2" Margin="16" IsVisible="False">
                <TextBlock x:Name="ImageNameText" FontWeight="SemiBold" FontSize="14" />
                <TextBlock x:Name="ImageCategoryText" FontSize="12" />
                <TextBlock x:Name="ImageSizeText" FontSize="12" />
                <TextBlock x:Name="ImageDimensionsText" FontSize="12" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>