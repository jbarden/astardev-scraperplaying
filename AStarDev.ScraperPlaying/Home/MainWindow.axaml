<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AStarDev.ScraperPlaying.Home.MainWindow"
        Title="AStarDev Scraper Playing"
        Width="900"
        Height="600"
        MinWidth="480"
        MinHeight="320">
  <Grid RowDefinitions="Auto,Auto,*" Margin="32">
    <TextBlock Text="AStarDev Scraper Playing"
               FontSize="28"
               FontWeight="SemiBold" />
    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="12"
                Margin="0,24,0,0">
      <Button Content="Import configuration" Click="ImportConfiguration" />
      <Button Content="Run Scraper" Click="RunScraper" />
    </StackPanel>
    <Border Grid.Row="2"
            Margin="0,24,0,0"
            Padding="24"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            CornerRadius="8">
      <ScrollViewer x:Name="StatusScrollViewer" VerticalScrollBarVisibility="Auto">
        <TextBlock Text="MainWindow is ready." x:Name="StatusTextBlock" TextWrapping="Wrap" FontSize="12" />
      </ScrollViewer>
    </Border>
  </Grid>
</Window>