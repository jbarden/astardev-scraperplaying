<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AStarDev.ScraperPlaying.UI.StartupErrorWindow"
        Title="AStarDev Scraper Playing"
        Width="800"
        Height="300"
        MinWidth="480"
        MinHeight="200">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="32">
    <TextBlock x:Name="ErrorTextBlock" TextWrapping="Wrap" FontSize="14" />
  </ScrollViewer>
</Window>
