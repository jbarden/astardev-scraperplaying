<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AStar.Dev.Velopack.Publishing.Avalonia.TestsUnit
    ═════════════════════════════════════════════════
    Unit tests for AStar.Dev.Velopack.Publishing.Avalonia.

    IsPackable=false and VSTestBlame are inherited from the root
    Directory.Build.props / Directory.Build.targets — nothing to set here.

    Uses a <ProjectReference> to the package rather than a <PackageReference>
    so changes to the package are immediately visible without a publish cycle.
  -->

  <ItemGroup>
      <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="coverlet.collector">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Pinned below the solution-wide xunit.v3 version: Avalonia.Headless.XUnit 12.1.1 is built
         against xunit.v3.extensibility.core 3.2.2 and breaks under xunit.v3 4.0.0's extensibility
         API changes (test discovery throws before Skip is even evaluated). No xunit v3-compatible
         Avalonia headless package exists yet - see https://github.com/AvaloniaUI/Avalonia/issues/18356. -->
    <PackageReference Include="xunit.v3.mtp-v2" VersionOverride="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
    <Using Include="NSubstitute" />
    <Using Include="Avalonia.Headless.XUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AStarDev.VelopackPublishingAvalonia\AStarDev.VelopackPublishingAvalonia.csproj" />
  </ItemGroup>

</Project>
