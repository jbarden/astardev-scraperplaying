<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AStarDev.VelopackPublishing.TestsUnit
    ═════════════════════════════════════════
    Unit tests for AStarDev.VelopackPublishing.

    IsPackable=false and VSTestBlame are inherited from the root
    Directory.Build.props / Directory.Build.targets — nothing to set here.

    Uses a <ProjectReference> to the package rather than a <PackageReference>
    so changes to the package are immediately visible without a publish cycle.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);IDE1006;</NoWarn>
  </PropertyGroup>

  <ItemGroup>
      <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" >
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
    <Using Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AStarDev.VelopackPublishing\AStarDev.VelopackPublishing.csproj" />
  </ItemGroup>

</Project>
